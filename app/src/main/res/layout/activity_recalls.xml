                            android:textColor="@color/text_primary_dark" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>
                -->

                <!-- Loading Container -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/recalls_loading_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/elevation_content_card"
                    app:cardBackgroundColor="@color/background_secondary"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding_standard"
                        android:gravity="center">

                        <ProgressBar
                            android:id="@+id/recalls_loading_indicator"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:indeterminateTint="@color/fault_success"
                            android:layout_marginBottom="@dimen/spacing_large" />

                        <TextView
                            android:id="@+id/recalls_status_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Searching for safety recalls..."
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_secondary_dark"
                            android:textAlignment="center"
                            android:gravity="center" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Results Container -->
                <LinearLayout
                    android:id="@+id/recalls_results_container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone" />

                <!-- Empty State (No Recalls Found) -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/recalls_empty_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/elevation_content_card"
                    app:cardBackgroundColor="@color/background_secondary"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="@dimen/spacing_xxl">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="✓"
                            android:textSize="64sp"
                            android:textColor="@color/fault_success"
                            android:layout_marginBottom="@dimen/spacing_large" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="No Recalls Found"
                            android:textSize="@dimen/text_section_header"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_dark"
                            android:layout_marginBottom="@dimen/spacing_small" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Great news! There are no active safety recalls for this vehicle."
                            android:textSize="@dimen/text_caption"
                            android:textColor="@color/text_tertiary_dark"
                            android:textAlignment="center"
                            android:gravity="center" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Error State -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/recalls_error_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/spacing_large"
                    app:cardCornerRadius="@dimen/card_corner_radius"
                    app:cardElevation="@dimen/elevation_content_card"
                    app:cardBackgroundColor="@color/fault_error"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/card_padding_standard">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⚠️ Error"
                            android:textSize="@dimen/text_section_header"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary_dark"
                            android:layout_marginBottom="@dimen/spacing_small" />

                        <TextView
                            android:id="@+id/recalls_error_message"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/text_body"
                            android:textColor="@color/text_hint_dark"
                            android:lineSpacingExtra="4dp" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Footer Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/footer_spacer_height" />

                </LinearLayout>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Overlay -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

    </FrameLayout>

    <!-- Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
