<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_primary">

    <!-- Content area with overlay support -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- Main Dashboard Container -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/spacing_large">

                <GridLayout
                    android:id="@+id/dashboard_grid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alignmentMode="alignMargins"
                    android:columnCount="2"
                    android:useDefaultMargins="true">

                    <!-- Live Data Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_live_data"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_live_data"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_live_data"
                                    android:contentDescription="Live Data"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Live Data"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Test Control Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_test_control"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_test_control"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_test_control"
                                    android:contentDescription="Test Control"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Test Control"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Fault Codes Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_fault_codes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_fault_codes"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_fault_codes"
                                    android:contentDescription="Fault Codes"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Fault Codes"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Fuel Economy Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_fuel_economy"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_fuel_economy"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_fuel_economy"
                                    android:contentDescription="Fuel Economy"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Fuel Economy"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Emissions Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_emissions"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_emissions"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_emissions"
                                    android:contentDescription="Emissions Diagnostics"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Emissions"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Vehicle Recalls Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_vehicle_recalls"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_recalls"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_recalls"
                                    android:contentDescription="@string/safety_recalls"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="@string/safety_recalls"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- ECU List Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_ecu_list"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_ecu_list"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔌"
                                    android:textSize="24sp"
                                    android:contentDescription="@string/ecu_list_title"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="@string/ecu_list_title"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Vehicle Info Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_vehicle_info"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_vehicle_info"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_dashboard_vehicle_info"
                                    android:contentDescription="VIN Decoder"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="VIN Decoder"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- CoPilot Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_copilot"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_copilot"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🤖"
                                    android:textSize="24sp"
                                    android:contentDescription="CoPilot AI Assistant"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="CoPilot"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Full Scan Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_full_scan"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_full_scan"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="🔍"
                                    android:textSize="24sp"
                                    android:contentDescription="Full Vehicle Scan"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Full Scan"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                    <!-- Track Mode Card -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_track_mode"
                        android:layout_columnSpan="2"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:foreground="?attr/selectableItemBackgroundBorderless"
                        android:layout_margin="@dimen/spacing_xs"
                        app:cardBackgroundColor="@color/background_secondary"
                        app:cardCornerRadius="@dimen/card_corner_radius"
                        app:cardElevation="@dimen/elevation_content_card"
                        app:cardUseCompatPadding="false"
                        android:layout_columnWeight="1">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:padding="@dimen/spacing_medium">

                            <LinearLayout
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                android:background="@drawable/circle_background_track_mode"
                                android:gravity="center">

                                <ImageView
                                    android:layout_width="28dp"
                                    android:layout_height="28dp"
                                    android:src="@drawable/ic_speedometer"
                                    android:contentDescription="Track Mode"/>
                            </LinearLayout>

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="@dimen/spacing_medium"
                                android:text="Track Mode"
                                android:textColor="@color/text_primary_dark"
                                android:textSize="@dimen/text_body"
                                android:textStyle="bold"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </GridLayout>

                <!-- Footer Spacer -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/footer_spacer_height" />

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

        <!-- Hidden ListView for MainActivity compatibility -->
        <ListView
            android:id="@android:id/list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="invisible"/>

        <!-- Overlay that appears when footer is expanded -->
        <View
            android:id="@+id/footer_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/background_overlay"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone"/>

        <!-- Auto-reconnect countdown bar -->
        <include
            android:id="@+id/auto_reconnect_countdown_bar"
            layout="@layout/auto_reconnect_countdown_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"/>

        <!-- Connection Loading Overlay - Just grey overlay, no spinner -->
        <FrameLayout
            android:id="@+id/connection_loading_overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#66000000"
            android:clickable="true"
            android:focusable="true"
            android:visibility="gone">

            <!-- Hidden text views for compatibility with existing code -->
            <TextView
                android:id="@+id/connection_loading_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/connection_loading_subtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

        </FrameLayout>

    </FrameLayout>

    <!-- Footer -->
    <com.obddroid.ui.components.VehicleInfoFooter
        android:id="@+id/vehicle_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/background_secondary"
        android:elevation="@dimen/elevation_footer"/>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
